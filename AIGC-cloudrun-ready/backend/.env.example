# The CloudBase service injects PORT at runtime. Keep 3001 for local development.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
TZ=Asia/Shanghai

# Optional writable state directory. Relative paths are resolved from backend/.
# RUNTIME_DIR=runtime

# Configure these in CloudBase service environment variables. Never commit a real key.

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=25000

# Optional real source search. If empty, the backend uses the curated catalog.
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search
SEARCH_TIMEOUT_MS=6000
SEARCH_RESULT_COUNT=10
