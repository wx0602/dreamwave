# The CloudBase service injects PORT at runtime. Keep 3001 for local development.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
TZ=Asia/Shanghai

# Optional writable state directory. Relative paths are resolved from backend/.
# RUNTIME_DIR=runtime

# Production multi-user persistence. For CloudBase MySQL, copy the private-network
# connection string from Database Settings -> Direct Connection.
# Example: mysql://root:password@10.0.0.8:3306/tcb
PERSISTENCE_DRIVER=file
REQUIRE_SHARED_PERSISTENCE=false
MYSQL_URL=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tcb
MYSQL_CONNECTION_LIMIT=10
MYSQL_AUTO_MIGRATE=true
AUTH_SESSION_TTL_DAYS=30

# Configure these in CloudBase service environment variables. Never commit a real key.

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=25000

# Optional real source search. If empty, the backend uses the curated catalog.
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search
SEARCH_TIMEOUT_MS=6000
SEARCH_RESULT_COUNT=10
