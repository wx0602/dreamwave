.journal-page{min-height:100vh;padding-bottom:60rpx}.journal-header{padding:44rpx 38rpx 24rpx}.journal-list{padding:0 24rpx 40rpx}.diary-card{margin-top:22rpx;padding:34rpx}.diary-top{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.diary-title{flex:1;font-size:34rpx;font-weight:700}.memory-mark{padding:7rpx 13rpx;border-radius:999rpx;color:#7a91a6;background:#eef5fa;font-size:18rpx;letter-spacing:2rpx}.diary-body{margin-top:20rpx;color:#607180;font-size:26rpx;line-height:1.75;white-space:pre-wrap}.diary-date{margin-top:22rpx;color:#9aa6b2;font-size:22rpx}.diary-actions{display:flex;gap:16rpx;margin-top:26rpx}.diary-actions button{flex:1}.syncing{padding:30rpx;text-align:center;color:#718497}.close-story{margin-top:28rpx}
