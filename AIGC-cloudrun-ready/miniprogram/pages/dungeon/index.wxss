.star-page{min-height:100vh;padding-bottom:70rpx}.star-header{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;padding:10rpx 6rpx 0}.star-header .page-title{margin-top:18rpx}.add-goal{display:flex;align-items:center;justify-content:center;flex:none;width:76rpx;height:76rpx;padding:0;border-radius:24rpx;color:#fff;background:linear-gradient(145deg,#8cbcf5,#7576dc);font-size:42rpx;line-height:1;box-shadow:0 12rpx 26rpx rgba(82,113,190,.24)}.goal-switcher{width:100%;margin-top:28rpx;white-space:nowrap}.goal-pills{display:inline-flex;gap:16rpx;padding:2rpx 6rpx 12rpx}.goal-pill{display:inline-block;width:300rpx;padding:22rpx;border:2rpx solid transparent;border-radius:28rpx;color:#64778a;background:rgba(255,255,255,.86);box-shadow:0 10rpx 24rpx rgba(79,120,160,.08)}.goal-pill.selected{border-color:#91bdf0;background:#fff;box-shadow:0 14rpx 30rpx rgba(79,130,190,.16)}.goal-pill-top{display:flex;justify-content:space-between;color:#7ca3cb;font-size:20rpx}.goal-pill-title{margin-top:10rpx;overflow:hidden;color:#344052;font-size:25rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.mini-track{height:7rpx;margin-top:15rpx;border-radius:99rpx;background:#e8f0f7;overflow:hidden}.mini-track view{height:100%;border-radius:99rpx;background:linear-gradient(90deg,#7cb9f5,#8b83df)}.mode-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx;margin-top:18rpx;padding:8rpx;border-radius:26rpx}.mode-tab{padding:20rpx 8rpx;border-radius:20rpx;color:#8292a2;text-align:center;font-size:23rpx}.mode-tab.active{color:#fff;background:linear-gradient(135deg,#76b5f2,#7778dc)}.goal-summary{display:flex;align-items:flex-end;justify-content:space-between;gap:20rpx;margin:34rpx 6rpx 18rpx}.summary-label{color:#7799ba;font-size:19rpx;font-weight:800;letter-spacing:2rpx;text-transform:uppercase}.summary-title{margin-top:8rpx;color:#2f3440;font-size:31rpx;font-weight:700;line-height:1.4}.summary-count{color:#598fc5;font-size:36rpx;font-weight:800}.summary-count text{color:#9eacba;font-size:22rpx}.sky-card{position:relative;height:450rpx;border:1rpx solid rgba(145,179,226,.28);border-radius:38rpx;background:radial-gradient(circle at 70% 25%,rgba(100,86,190,.3),transparent 30%),radial-gradient(circle at 20% 75%,rgba(53,155,205,.22),transparent 32%),linear-gradient(160deg,#111832,#1b2b58 58%,#263d69);box-shadow:0 18rpx 42rpx rgba(40,70,115,.24);overflow:hidden}.sky-card::before{content:"";position:absolute;inset:0;opacity:.42;background-image:radial-gradient(circle,#fff 1rpx,transparent 2rpx),radial-gradient(circle,#9cc9ff 1rpx,transparent 2rpx);background-position:0 0,38rpx 54rpx;background-size:92rpx 92rpx,126rpx 126rpx}.nebula{position:absolute;border-radius:50%;filter:blur(24rpx)}.nebula-one{top:80rpx;right:40rpx;width:240rpx;height:160rpx;background:rgba(128,101,225,.13)}.nebula-two{bottom:20rpx;left:30rpx;width:260rpx;height:160rpx;background:rgba(77,177,215,.1)}.sky-caption{position:absolute;z-index:5;top:24rpx;left:28rpx;right:28rpx;display:flex;justify-content:space-between;color:#8ea8d0;font-size:19rpx;letter-spacing:1rpx}.constellation-line{position:absolute;z-index:1;height:2rpx;background:rgba(135,176,233,.45);box-shadow:0 0 8rpx rgba(108,163,234,.25);transform-origin:left center}.major-star{position:absolute;z-index:2;width:26rpx;height:26rpx;margin:-13rpx 0 0 -13rpx;color:#d9e9ff;font-size:25rpx;line-height:26rpx;text-align:center;text-shadow:0 0 14rpx rgba(151,194,255,.9)}.day-star{position:absolute;z-index:4;width:22rpx;height:22rpx;margin:-11rpx 0 0 -11rpx}.day-star view{width:100%;height:100%;border:2rpx solid rgba(152,181,220,.48);border-radius:50%;background:#283a63}.day-star.done view{border-color:#fff2c5;background:#ffd579;box-shadow:0 0 8rpx #fff,0 0 20rpx #79b6ff}.day-star.available{width:34rpx;height:34rpx;margin:-17rpx 0 0 -17rpx}.day-star.available view{border:4rpx solid #e9f5ff;background:#79b8f5;box-shadow:0 0 24rpx rgba(112,181,255,.95);animation:starPulse 1.7s ease-in-out infinite}.day-star text{position:absolute;top:34rpx;left:50%;padding:4rpx 10rpx;border-radius:99rpx;color:#fff;background:rgba(76,128,193,.9);font-size:16rpx;white-space:nowrap;transform:translateX(-50%)}.today-card{display:flex;gap:22rpx;margin-top:22rpx;padding:28rpx}.today-icon{display:flex;align-items:center;justify-content:center;flex:none;width:76rpx;height:76rpx;border-radius:24rpx;color:#fff;background:linear-gradient(145deg,#79bdf6,#7778da);font-size:34rpx}.today-main{min-width:0}.today-label{color:#6598ca;font-size:20rpx;font-weight:700}.today-title{margin-top:7rpx;color:#354052;font-size:27rpx;font-weight:700;line-height:1.45}.today-copy{margin-top:8rpx;color:#8794a2;font-size:21rpx;line-height:1.5}.companion-card{margin-top:20rpx;padding:26rpx}.section-mini{color:#354052;font-weight:700}.companion-item{display:flex;gap:12rpx;margin-top:13rpx;color:#788898;font-size:23rpx}.companion-item.done{color:#b18436}.atlas-view,.tools-view{margin-top:28rpx}.atlas-card{display:grid;grid-template-columns:150rpx 1fr 24rpx;align-items:center;gap:22rpx;margin-top:18rpx;padding:18rpx}.atlas-night{display:flex;flex-direction:column;align-items:center;justify-content:center;height:126rpx;border-radius:24rpx;color:#dbe9ff;background:linear-gradient(145deg,#172043,#2c4272);font-size:20rpx}.atlas-stars{margin-bottom:8rpx;color:#ffe2a0;text-align:center;line-height:1.4}.atlas-title{font-size:27rpx;font-weight:700}.atlas-meta{margin-top:10rpx;color:#8b99a7;font-size:21rpx}.atlas-arrow{color:#89a8c5;font-size:38rpx}.tools-intro{padding:24rpx;color:#708293;font-size:22rpx;line-height:1.6}.tool-card{display:grid;grid-template-columns:80rpx 1fr auto;align-items:center;gap:20rpx;margin-top:16rpx;padding:24rpx}.tool-card.locked{opacity:.55}.tool-icon,.tool-modal-icon{display:flex;align-items:center;justify-content:center;width:74rpx;height:74rpx;border-radius:23rpx;color:#fff;background:linear-gradient(145deg,#8cbcf5,#7b78d8);font-size:34rpx}.tool-name{font-size:27rpx;font-weight:700}.tool-detail{margin-top:6rpx;color:#8493a1;font-size:21rpx;line-height:1.45}.tool-count{color:#609ad0;font-weight:700}.tool-lock{color:#9ba7b2;font-size:20rpx}.loading-pill{position:fixed;z-index:50;top:22rpx;left:50%;display:flex;align-items:center;gap:12rpx;padding:12rpx 24rpx;border-radius:999rpx;color:#4f6070;background:rgba(255,255,255,.94);box-shadow:0 10rpx 24rpx rgba(50,90,130,.12);transform:translateX(-50%);font-size:21rpx}.star-modal-icon{display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;margin:0 auto 22rpx;border-radius:50%;color:#8294ab;background:#edf3f8;font-size:44rpx}.star-modal-icon.done{color:#d2a34d;background:#fff5d9}.star-status{margin-top:10rpx;color:#6496c5;font-size:22rpx}.atlas-modal-mark{text-align:center;color:#c69645;font-size:30rpx;letter-spacing:10rpx}.target-empty{padding:30rpx;color:#8b99a6;text-align:center}.target-task{display:flex;align-items:center;justify-content:space-between;width:100%;margin-top:14rpx;padding:0 24rpx;border-radius:22rpx;color:#445f80;background:#edf5ff;font-size:24rpx;text-align:left}.target-task text:first-child{max-width:88%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.target-task text:last-child{color:#729ed1;font-size:34rpx}.close-tool{margin-top:22rpx}.modal-input{margin-top:20rpx}@keyframes starPulse{0%,100%{transform:scale(.82);opacity:.78}50%{transform:scale(1.18);opacity:1}}
