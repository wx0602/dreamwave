<view class="star-page watercolor-page"><view class="page-pad">
  <view class="star-header">
    <view><view class="tag">GOAL CONSTELLATION SERIES</view><view class="page-title">我的星图</view><view class="page-subtitle">一个长期目标是一组星图系列；每个主线任务点亮一颗星。</view></view>
    <button class="add-goal" bindtap="openGoal">＋</button>
  </view>

  <scroll-view class="goal-switcher" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{goals.length}}">
    <view class="goal-pills">
      <view class="goal-pill {{item.goalId===selectedGoalId?'selected':''}}" wx:for="{{goals}}" wx:key="goalId" data-id="{{item.goalId}}" bindtap="selectGoal">
        <view class="goal-pill-top"><text>{{item.constellationName}}</text><text>{{item.completedStars}}/{{item.totalStarCount}} 星</text></view>
        <view class="goal-pill-title">{{item.title}}</view>
        <view class="mini-track"><view style="width:{{item.progress}}%"></view></view>
      </view>
    </view>
  </scroll-view>

  <view class="mode-tabs card">
    <view class="mode-tab {{mode==='current'?'active':''}}" data-mode="current" bindtap="switchMode">当前星图</view>
    <view class="mode-tab {{mode==='atlas'?'active':''}}" data-mode="atlas" bindtap="switchMode">星图图鉴</view>
    <view class="mode-tab {{mode==='tools'?'active':''}}" data-mode="tools" bindtap="switchMode">星宿道具</view>
  </view>

  <view wx:if="{{mode==='current'}}">
    <view class="empty card" wx:if="{{!activeGoal}}">还没有长期目标，点击右上角 ＋ 创建第一张星图。</view>
    <block wx:else>
      <view class="goal-summary"><view><view class="summary-label">{{constellationLatin}}</view><view class="summary-title">{{constellationName}} · {{activeGoal.title}}</view></view><view class="summary-count">{{activeGoal.completedStars}}<text>/{{activeGoal.totalStarCount}} 星</text></view></view>
      <scroll-view class="goal-switcher" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{seriesMaps.length>1}}"><view class="goal-pills"><view class="goal-pill {{item.mapId===selectedMapId?'selected':''}}" wx:for="{{seriesMaps}}" wx:key="mapId" data-id="{{item.mapId}}" bindtap="selectMap"><view class="goal-pill-top"><text>第 {{item.order}} 图</text><text>{{item.completedStars}}/{{item.starCount}}</text></view><view class="goal-pill-title">{{item.constellationName}}</view><view class="mini-track"><view style="width:{{item.progress}}%"></view></view></view></view></scroll-view>
      <view class="sky-card">
        <view class="nebula nebula-one"></view><view class="nebula nebula-two"></view>
        <view class="sky-caption"><text>{{constellationName}}</text><text>{{activeGoal.status==='COMPLETED'?'已完整点亮':'星图观测中'}}</text></view>
        <view class="constellation-line" wx:for="{{lines}}" wx:key="id" style="left:{{item.x}}rpx;top:{{item.y}}rpx;width:{{item.length}}rpx;transform:rotate({{item.angle}}deg)"></view>
        <view class="major-star" wx:for="{{majorStars}}" wx:key="id" style="left:{{item.x}}rpx;top:{{item.y}}rpx">✦</view>
        <view class="day-star {{item.done?'done':item.available?'available':'locked'}}" wx:for="{{dailyStars}}" wx:key="nodeId" data-index="{{index}}" bindtap="showStar" style="left:{{item.x}}rpx;top:{{item.y}}rpx;width:{{item.compactSize}}rpx;height:{{item.compactSize}}rpx;margin:{{item.compactOffset}}rpx 0 0 {{item.compactOffset}}rpx"><view class="star-glyph">✦</view><text wx:if="{{item.showTodayLabel}}">今日</text></view>
      </view>
      <view class="today-card card">
        <view class="today-icon">{{todayTask?'✦':'✓'}}</view><view class="today-main"><view class="today-label">{{todayTask?'今日核心':'今日已完成'}}</view><view class="today-title">{{todayTask?'今天先完成这一项核心行动':'下一项核心行动将在明天刷新后解锁'}}</view><view class="today-copy">{{todayTask?'完成后点亮一颗星；可选行动不会改变星图进度。':'可以继续其他并行目标或自定义任务。'}}</view></view>
      </view>
      <view class="companion-card card" wx:if="{{companionStars.length}}"><view class="section-mini">今日伴星</view><view class="companion-item {{item.done?'done':''}}" wx:for="{{companionStars}}" wx:key="taskId"><text>{{item.done?'✦':'☆'}}</text>{{item.title}}</view></view>
    </block>
  </view>

  <view class="atlas-view" wx:if="{{mode==='atlas'}}">
    <view class="empty card" wx:if="{{!atlas.length}}">完整点亮一张长期目标星图后，会永久收入这里。</view>
    <view class="atlas-card card" wx:for="{{atlas}}" wx:key="mapId" data-index="{{index}}" bindtap="showAtlas"><view class="atlas-night"><view class="atlas-stars">✦　·　✦<br/>　✦　·</view><view>{{item.constellationName}}</view></view><view class="atlas-info"><view class="atlas-title">{{item.title}} · 第 {{item.order}} 图</view><view class="atlas-meta">{{item.totalStarCount}} 颗星 · {{item.displayDate}}</view></view><text class="atlas-arrow">›</text></view>
  </view>

  <view class="tools-view" wx:if="{{mode==='tools'}}">
    <view class="tools-intro card">系列中每完成一张星图，都可以获得一次道具使用机会。道具直接帮助真实任务。</view>
    <view class="tool-card card {{item.owned?'owned':'locked'}}" wx:for="{{tools}}" wx:key="toolId" data-index="{{index}}" bindtap="openTool"><view class="tool-icon {{item.theme}}"><text class="tool-glyph">{{item.icon}}</text></view><view class="tool-main"><view class="tool-name">{{item.name}}</view><view class="tool-detail">{{item.detail}}</view></view><view class="tool-count" wx:if="{{item.owned}}">×{{item.charges}}</view><view class="tool-lock" wx:else>未获得</view></view>
  </view>
</view><view class="loading-pill" wx:if="{{loading}}"><view class="mini-spinner"></view>正在同步星图</view></view>

<view class="modal-mask" wx:if="{{starDetail}}" bindtap="closeStar"><view class="modal-card" catchtap="noop"><view class="star-modal-icon {{starDetail.done?'done':''}}">✦</view><view class="modal-title">第 {{starDetail.day}} 天</view><view class="star-status">{{starDetail.statusLabel}}</view><view class="modal-body"><view>{{starDetail.title}}</view><view style="margin-top:20rpx">{{starDetail.detail}}</view></view><button class="primary-button small-button" bindtap="closeStar">返回星图</button></view></view>
<view class="modal-mask" wx:if="{{atlasDetail}}" bindtap="closeAtlas"><view class="modal-card" catchtap="noop"><view class="atlas-modal-mark">✦ · ✦ · ✦</view><view class="modal-title">{{atlasDetail.constellationName}} · {{atlasDetail.title}}</view><view class="modal-body">这是长期目标系列的第 {{atlasDetail.order}} 张星图，共完成 {{atlasDetail.totalStarCount}} 颗主线星，于 {{atlasDetail.displayDate}} 完整点亮。</view><button class="primary-button small-button" bindtap="closeAtlas">合上图鉴</button></view></view>
<view class="modal-mask" wx:if="{{toolModal}}" bindtap="closeTool"><view class="modal-card" catchtap="noop"><view class="tool-modal-icon {{selectedTool.theme}}"><text class="tool-glyph">{{selectedTool.icon}}</text></view><view class="modal-title">使用{{selectedTool.name}}</view><view class="modal-body">{{selectedTool.detail}}。请选择任务：</view><view class="target-empty" wx:if="{{!toolTargets.length}}">当前没有符合条件的任务。</view><button class="target-task" wx:for="{{toolTargets}}" wx:key="taskId" data-index="{{index}}" bindtap="useTool"><text>{{item.title}}</text><text>›</text></button><button class="secondary-button small-button close-tool" bindtap="closeTool">取消</button></view></view>
<view class="modal-mask" wx:if="{{story}}"><view class="modal-card"><view class="modal-title">{{story.title}}</view><view class="modal-body">{{story.body}}</view><view class="story-meta" wx:if="{{story.meta}}">{{story.meta}}</view><button class="primary-button small-button" bindtap="closeStory">知道了</button></view></view>
