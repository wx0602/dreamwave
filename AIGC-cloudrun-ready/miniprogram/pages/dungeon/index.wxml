<view class="dungeon-page watercolor-page"><view class="page-pad"><view class="dungeon-heading"><view class="tag">NIGHT DUNGEON</view><view class="page-title">夜间副本</view><view class="page-subtitle">今日的学习痕迹会在夜幕中转化为新的挑战。</view></view>
 <view class="status-card card"><view class="status-orb">☾</view><view class="status-text">{{statusText}}</view><view class="current-time">当前位面时间：{{currentTime}}</view><view class="countdown" wx:if="{{countdown}}">{{countdown}}</view><view class="stats">{{stats}}</view></view>
 <view class="demo-row card"><view><view class="demo-title">比赛演示模式</view><view class="hint">忽略 22:00 开放限制，用于完整流程演示</view></view><switch checked="{{demo}}" color="#6FB6FF" bindchange="demoChange"/></view>
 <button class="primary-button enter" disabled="{{!canEnter||loading}}" loading="{{loading}}" bindtap="enter">{{buttonText}}</button>
 <view class="section-title">副本补给</view><view class="resource card">当前资源点：{{resources}}</view><view class="page-subtitle supply-hint">先补给，再进入夜幕章节。已购买道具会影响后续分支。</view>
 <view class="shop-grid"><view class="shop-card card {{item.purchased?'purchased':''}}" wx:for="{{shop}}" wx:key="itemId" data-index="{{index}}" bindtap="buy"><view class="shop-icon">✦</view><view class="shop-name">{{item.name}}</view><view class="shop-type">{{item.type}}</view><view class="shop-effect">{{item.effect}}</view><view class="shop-price">{{item.purchased?'已获得':item.price+' 点'}}</view></view></view>
</view></view>
<view class="modal-mask" wx:if="{{story}}"><view class="modal-card"><image class="story-image" wx:if="{{story.asset}}" src="{{story.asset}}" mode="aspectFit"/><view class="modal-title">{{story.title}}</view><view class="modal-body">{{story.body}}</view><button class="primary-button small-button close" bindtap="closeStory">继续</button></view></view>
