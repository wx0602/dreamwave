<view class="profile-page watercolor-page"><view class="page-pad">
 <view class="hero-card card"><image class="avatar" src="{{avatar}}" mode="aspectFill"/><view class="name">{{name}}</view><view class="role">当前职业：{{role}}</view><view class="level">LV.{{level}}</view><view class="progress-track exp"><view class="progress-fill" style="width:{{growthPercent}}%"></view></view><view class="chapter">当前章节：{{chapter}}</view></view>
 <view class="stats card"><view><text>成长值</text><text class="stat-value">{{growth}}</text></view><view class="stats-line"></view><view><text>资源点</text><text class="stat-value">{{resources}}</text></view></view>
 <view class="info-card card"><view class="section-heading">当前目标</view><view class="copy">{{goal}}</view></view>
 <view class="info-card card"><view class="section-heading">目标地图进度</view><view class="copy pre">{{goalProgress}}</view><button class="secondary-button small-button map-button" bindtap="openGoalMap">查看目标地图</button></view>
 <view class="expand-card card" bindtap="toggleSkills"><view class="expand-head"><text>成就与真实指标（{{achievements.length}}）</text><text>{{skillsExpanded?'⌃':'⌄'}}</text></view><view class="chips" wx:if="{{skillsExpanded}}"><view class="chip" wx:for="{{achievements}}" wx:key="*this">{{item}}</view></view></view>
 <view class="expand-card card" bindtap="toggleBag"><view class="expand-head"><text>背包（{{bag.length}}）</text><text>{{bagExpanded?'⌃':'⌄'}}</text></view><view class="chips" wx:if="{{bagExpanded}}"><view class="chip" wx:for="{{bag}}" wx:key="*this">{{item}}</view><view class="hint" wx:if="{{!bag.length}}">暂无商店装备</view></view></view>
 <button class="logout" bindtap="logout">退出当前账号</button>
</view></view>
