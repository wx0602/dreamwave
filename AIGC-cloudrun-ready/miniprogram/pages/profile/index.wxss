.profile-page{min-height:100vh}.hero-card{padding:34rpx;text-align:center}.avatar{width:500rpx;height:520rpx;border-radius:34rpx;background:#dceeff}.name{margin-top:24rpx;font-size:42rpx;font-weight:700}.role,.chapter{margin-top:12rpx;color:#6c7a89}.level{margin-top:22rpx;color:#4f9ef0;font-size:34rpx;font-weight:700}.exp{margin-top:18rpx}.stats{display:flex;align-items:center;margin-top:24rpx;padding:32rpx}.stats>view:not(.stats-line){flex:1;text-align:center}.stats text{display:block;color:#718497}.stats .stat-value{display:block;margin-top:10rpx;color:#4f9ef0;font-size:38rpx;font-weight:700}.stats-line{width:2rpx;height:80rpx;background:#dceeff}.info-card,.expand-card{margin-top:24rpx;padding:32rpx}.section-heading,.expand-head{font-size:30rpx;font-weight:700}.copy{margin-top:18rpx;color:#607180;line-height:1.7}.pre{white-space:pre-wrap}.map-button{margin-top:24rpx}.expand-head{display:flex;justify-content:space-between}.chips{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:22rpx}.chip{padding:14rpx 20rpx;border-radius:20rpx;color:#607180;background:#edf6fc;font-size:23rpx}.logout{margin-top:34rpx;color:#8b99a6;background:transparent;font-size:25rpx}
