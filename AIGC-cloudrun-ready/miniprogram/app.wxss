page {
  min-height: 100%;
  background: #f4f9ff;
  color: #2f3440;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}
view, scroll-view, swiper, image, text, button, input, textarea, picker, switch {
  box-sizing: border-box;
}
button::after { border: 0; }
.page-shell { min-height: 100vh; background: #f4f9ff; }
.watercolor-page {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(160deg, #f8fcff 0%, #edf8ff 46%, #f6fbff 100%);
  overflow: hidden;
}
.watercolor-page::before {
  content: "";
  position: absolute;
  z-index: 0;
  left: -18%;
  right: -18%;
  bottom: -12%;
  height: 62%;
  pointer-events: none;
  background: radial-gradient(ellipse at 50% 70%, rgba(114,203,231,.34), transparent 58%), radial-gradient(ellipse at 10% 75%, rgba(86,159,204,.18), transparent 45%);
  filter: blur(4px);
}
.watercolor-page > view { position: relative; z-index: 1; }
.page-pad { padding: 36rpx 36rpx 56rpx; }
.page-title { font-size: 48rpx; line-height: 1.25; font-weight: 700; color: #2f3440; }
.page-subtitle { margin-top: 12rpx; font-size: 28rpx; line-height: 1.65; color: #6c7a89; }
.section-title { margin: 40rpx 0 18rpx; font-size: 30rpx; font-weight: 700; color: #2f3440; }
.card {
  background: rgba(255,255,255,.94);
  border: 1rpx solid rgba(217,234,247,.95);
  border-radius: 40rpx;
  box-shadow: 0 12rpx 34rpx rgba(79,158,240,.10);
}
.glass-card {
  background: rgba(255,255,255,.82);
  border: 1rpx solid rgba(255,255,255,.88);
  border-radius: 44rpx;
  box-shadow: 0 16rpx 44rpx rgba(46,105,151,.14);
  backdrop-filter: blur(12px);
}
.primary-button, .secondary-button, .danger-button {
  width: 100%; min-height: 96rpx; padding: 0 30rpx; border-radius: 28rpx;
  font-size: 30rpx; font-weight: 600; line-height: 96rpx;
}
.primary-button { color: #fff; background: linear-gradient(135deg,#6fb6ff,#4f9ef0); box-shadow: 0 12rpx 26rpx rgba(79,158,240,.25); }
.secondary-button { color: #4f9ef0; background: #fff; border: 2rpx solid #a9d4ff; }
.danger-button { color: #cf6868; background: #fff3f3; border: 2rpx solid #efcaca; }
.primary-button[disabled], .secondary-button[disabled] { opacity: .55; }
.small-button { min-height: 72rpx; line-height: 72rpx; border-radius: 22rpx; font-size: 25rpx; }
.field { margin-top: 24rpx; }
.field-label { display: block; margin-bottom: 12rpx; font-size: 25rpx; font-weight: 600; color: #4f6070; }
.field-control {
  width: 100%; min-height: 92rpx; padding: 24rpx 26rpx; background: #f8fbff;
  border: 2rpx solid #dceeff; border-radius: 24rpx; color: #2f3440; font-size: 28rpx;
}
.field-control.textarea { min-height: 160rpx; }
.hint { color: #9aa6b2; font-size: 24rpx; line-height: 1.6; }
.tag { display: inline-flex; padding: 8rpx 20rpx; border-radius: 999rpx; color: #4f9ef0; background: #e9f5ff; font-size: 22rpx; font-weight: 600; }
.empty { padding: 64rpx 30rpx; text-align: center; color: #8b99a6; }
.loading-block { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 56vh; }
.loading-orb { width: 112rpx; height: 112rpx; border-radius: 50%; border: 8rpx solid #dceeff; border-top-color: #4f9ef0; animation: spin 1s linear infinite; }
.loading-stage { margin-top: 34rpx; color: #4f6070; font-size: 30rpx; font-weight: 600; }
.progress-track { overflow: hidden; width: 100%; height: 16rpx; border-radius: 20rpx; background: #dceeff; }
.progress-fill { height: 100%; border-radius: 20rpx; background: linear-gradient(90deg,#6fb6ff,#75d7ca); transition: width .3s; }
.modal-mask { position: fixed; z-index: 1000; inset: 0; display: flex; align-items: center; justify-content: center; padding: 44rpx; background: rgba(23,39,56,.46); }
.modal-card { width: 100%; max-height: 82vh; overflow-y: auto; padding: 42rpx 36rpx; background: rgba(255,255,255,.98); border-radius: 42rpx; box-shadow: 0 24rpx 70rpx rgba(15,38,59,.25); }
.modal-title { font-size: 38rpx; font-weight: 700; color: #2f3440; }
.modal-body { margin-top: 20rpx; white-space: pre-wrap; color: #607180; line-height: 1.75; }
.modal-actions { display: flex; gap: 18rpx; margin-top: 34rpx; }
.modal-actions button { flex: 1; }
.story-image { display: block; width: 260rpx; height: 260rpx; margin: 0 auto 24rpx; object-fit: contain; border-radius: 28rpx; }
.story-label { margin-bottom: 18rpx; text-align: center; color: #6d83a0; font-size: 23rpx; }
@keyframes spin { to { transform: rotate(360deg); } }

/* 星图专属视觉：页面框架保持浅色，仅星幕与藏品采用深色、金色体系。 */
.star-page .constellation-line {
  height: 2rpx;
  background: linear-gradient(90deg, rgba(255,214,126,.14), rgba(255,226,156,.82), rgba(255,214,126,.14));
  box-shadow: 0 0 12rpx rgba(239,190,89,.38);
}
.star-page .major-star {
  color: #ffe4a1;
  text-shadow: 0 0 8rpx #fff4cf, 0 0 22rpx rgba(255,190,67,.88);
}
.star-page .day-star .star-glyph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  border: 0 !important;
  border-radius: 0 !important;
  color: #927b50;
  background: transparent !important;
  font-size: 31rpx;
  line-height: 1;
  text-shadow: 0 0 8rpx rgba(219,176,91,.2);
  transform-origin: center;
}
.star-page .day-star.locked .star-glyph { opacity: .34; color: #ad9362; }
.star-page .day-star.done .star-glyph {
  opacity: 1;
  color: #ffd36b;
  text-shadow: 0 0 5rpx #fff7d6, 0 0 14rpx #ffc54d, 0 0 28rpx rgba(255,177,54,.9);
}
.star-page .day-star.available .star-glyph {
  color: #ffe29a;
  text-shadow: 0 0 6rpx #fff, 0 0 18rpx #ffc95f, 0 0 36rpx rgba(255,184,60,.96);
}

.star-page .tool-icon,
.star-page .tool-modal-icon {
  position: relative;
  isolation: isolate;
  overflow: visible;
  border: 2rpx solid rgba(255,246,218,.9);
  box-shadow: inset 0 0 0 5rpx rgba(255,255,255,.12), 0 10rpx 26rpx rgba(26,35,66,.25);
}
.star-page .tool-icon::before,
.star-page .tool-modal-icon::before {
  content: "";
  position: absolute;
  z-index: -1;
  inset: 10rpx;
  border: 1rpx solid rgba(255,239,196,.66);
  border-radius: 17rpx;
  transform: rotate(45deg);
}
.star-page .tool-icon::after,
.star-page .tool-modal-icon::after {
  content: "✦";
  position: absolute;
  top: -11rpx;
  right: -8rpx;
  color: #ffe6a3;
  font-size: 23rpx;
  text-shadow: 0 0 10rpx rgba(255,203,93,.9);
}
.star-page .tool-glyph {
  position: relative;
  z-index: 2;
  color: #fff8df;
  font-size: 32rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(15,19,36,.42), 0 0 12rpx rgba(255,231,168,.46);
}
.star-page .tool-icon.focus,
.star-page .tool-modal-icon.focus { background: radial-gradient(circle at 36% 28%, #7c76c8, #343261 58%, #171a38); }
.star-page .tool-icon.insight,
.star-page .tool-modal-icon.insight { background: radial-gradient(circle at 36% 28%, #e7b96a, #9c6331 58%, #4f2d22); }
.star-page .tool-icon.memory,
.star-page .tool-modal-icon.memory { background: radial-gradient(circle at 36% 28%, #75c9b1, #287b70 58%, #164642); }
.star-page .tool-icon.mirror,
.star-page .tool-modal-icon.mirror { background: radial-gradient(circle at 36% 28%, #a8d8ed, #527ca9 58%, #293d6d); }
.star-page .tool-icon.guardian,
.star-page .tool-modal-icon.guardian { background: radial-gradient(circle at 36% 28%, #dc8a76, #983f46 58%, #551f35); }
