.run-heading{padding:18rpx 6rpx 30rpx}.run-heading .page-title{margin-top:18rpx}.run-card{padding:38rpx}.run-progress{color:#4f9ef0;font-size:25rpx;font-weight:700}.run-chapter{margin-top:14rpx;font-size:31rpx;font-weight:700}.run-state{display:inline-block;margin-top:18rpx;padding:10rpx 20rpx;border-radius:999rpx;color:#4f7fab;background:#dceeff;font-size:22rpx;font-weight:700}.event-title{margin-top:34rpx;font-size:38rpx;font-weight:700;line-height:1.45}.event-desc{margin-top:20rpx;color:#607180;line-height:1.85}.choices{margin-top:30rpx}.choice{display:flex;align-items:center;justify-content:space-between;width:100%;margin-top:16rpx;padding:0 28rpx;border:2rpx solid #dceeff;border-radius:26rpx;color:#3e6688;background:#f5faff;font-size:27rpx;text-align:left}.choice text{font-size:42rpx;color:#6fb6ff}.settle,.back{margin-top:32rpx}.loading-cover{position:fixed;z-index:10;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24rpx;color:#4f6070;background:rgba(244,249,255,.82);backdrop-filter:blur(8px)}
