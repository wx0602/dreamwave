<view class="settlement-page watercolor-page"><view class="settlement-card glass-card" wx:if="{{!story}}"><view class="loading-orb"></view><view class="page-title title">副本结算中</view><view class="loading-stage">{{stage}}</view><view class="progress-row"><view class="progress-track"><view class="progress-fill" style="width:{{progress}}%"></view></view><text>{{progress}}%</text></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="error-actions" wx:if="{{error}}"><button class="primary-button small-button" bindtap="settle">重试</button><button class="secondary-button small-button" bindtap="done">返回副本</button></view></view><view class="settlement-card glass-card" wx:else><image class="story-image" wx:if="{{story.asset}}" src="{{story.asset}}" mode="aspectFit"/><view class="page-title">{{story.title}}</view><view class="story">{{story.body}}</view><view class="reward" wx:if="{{story.meta}}">奖励：{{story.meta}}</view><button class="primary-button" bindtap="done">收下成果</button></view></view>
