<view class="completion-page watercolor-page">
  <view class="completion-panel glass-card" wx:if="{{status==='INPUT'}}">
    <view class="completion-symbol">✦</view>
    <view class="page-title completion-title">完成「{{task.title}}」</view>
    <view class="page-subtitle">留下一句今天的线索吗？这会帮助旅程伙伴记住你的真实进展。</view>
    <textarea class="summary-input" value="{{summary}}" maxlength="100" placeholder="可选，5—100 个字；也可以直接跳过" bindinput="input"></textarea>
    <view class="summary-hint">总结只写入任务、日志与记忆，不影响奖励。<text>{{summaryLength}}/100</text></view>
    <button class="primary-button" bindtap="complete">完成并结算</button><view class="skip-summary" bindtap="skipSummary">暂不总结</view>
    <view class="error" wx:if="{{error}}">{{error}}</view>
  </view>
  <view class="completion-panel glass-card" wx:elif="{{status==='SUBMITTING'}}">
    <view class="loading-orb"></view><view class="page-title completion-title">正在完成任务</view><view class="page-subtitle">正在保存完成记录与下一步建议…</view>
  </view>
  <view class="completion-panel story-panel glass-card" wx:else><view class="completion-symbol">✓</view><view class="page-title">{{story.title}}</view><view class="reward" wx:if="{{story.meta}}"><view>奖励与下一步建议</view><view>{{story.meta}}</view></view><view class="story-toggle" bindtap="toggleStory">{{storyExpanded?'收起剧情':'查看剧情'}}　⌄</view><block wx:if="{{storyExpanded}}"><image class="story-image" wx:if="{{story.asset}}" src="{{story.asset}}" mode="aspectFit"/><view class="story-label" wx:if="{{story.assetLabel}}">{{story.assetLabel}}</view><view class="story-body">{{story.body}}</view></block><button class="primary-button" bindtap="home">返回主页</button></view>
</view>
