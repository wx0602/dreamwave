.completion-page { display:flex; align-items:center; min-height:100vh; padding:48rpx; }
.completion-panel { width:100%; padding:58rpx 40rpx; text-align:center; }
.completion-title { margin-top:36rpx; }
.progress-row { display:flex; align-items:center; gap:18rpx; margin-top:32rpx; color:#4f9ef0; font-weight:700; }
.error { margin-top:26rpx; color:#c56565; line-height:1.6; }
.error-actions { display:flex; gap:18rpx; margin-top:28rpx; }
.error-actions button { flex:1; }
.story-body { margin:30rpx 0; color:#607180; text-align:left; line-height:1.85; white-space:pre-wrap; }
.reward { margin:0 0 32rpx; padding:24rpx; border-radius:24rpx; color:#4f9ef0; background:#eef7ff; line-height:1.7; }
