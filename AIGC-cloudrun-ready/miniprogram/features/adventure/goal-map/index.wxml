<view class="workbench-page watercolor-page">
  <view class="page-pad">
    <view class="workbench-header">
      <view><view class="tag">目标管理</view><view class="page-title">目标工作台</view><view class="page-subtitle">查看每条路线的来源与节奏，今天只发布一项核心行动。</view></view>
      <button class="add-goal-button" bindtap="openGoal">＋</button>
    </view>

    <scroll-view class="goal-switcher" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{goals.length}}">
      <view class="goal-list">
        <view class="goal-card {{item.goalId===selectedGoalId?'selected':''}}" wx:for="{{goals}}" wx:key="goalId" data-id="{{item.goalId}}" bindtap="selectGoal">
          <view class="goal-card-top"><text>{{item.priorityLabel}}</text><text>{{item.statusLabel}}</text></view>
          <view class="goal-card-title">{{item.title}}</view>
          <view class="goal-card-meta">{{item.completedStars}}/{{item.totalStarCount}} 星 · {{item.mapDone}}/{{item.mapTotal}} 图</view>
          <view class="mini-track"><view style="width:{{item.progress}}%"></view></view>
          <button class="priority-link" data-id="{{item.goalId}}" catchtap="setGoalPriority">调整优先级</button>
        </view>
      </view>
    </scroll-view>

    <view class="empty-state card" wx:if="{{!activeGoal}}">
      <view class="empty-star">✦</view><view class="empty-title">还没有长期目标</view><view class="empty-copy">创建目标后，Agent 会先搜索来源，再把计划交给你确认。</view><button class="primary-button small-button" bindtap="openGoal">创建长期目标</button>
    </view>

    <block wx:else>
      <view class="overview-card card">
        <view class="overview-head"><view><view class="eyebrow">当前系列 · {{activeGoal.priorityLabel}}</view><view class="overview-title">{{activeGoal.title}}</view></view><button class="map-link" bindtap="openStarMap">查看星图 ›</button></view>
        <view class="metric-row"><view class="metric"><text>{{activeGoal.completedStars}}/{{activeGoal.totalStarCount}}</text><view>已点亮核心星数</view></view></view>
        <view class="current-map"><view class="map-mark">✦</view><view class="map-copy"><view>第 {{currentMapOrder}} 图 · {{currentMapName}}</view><text>当前星图已点亮 {{currentMapProgress}}%</text></view><view class="map-percent">{{currentMapProgress}}%</view></view>
      </view>

      <view class="planning-card card"><view class="planning-head"><view class="section-title">已确认路线</view></view><view class="source-summary" wx:for="{{confirmedSources}}" wx:key="sourceId">{{item.title}}<text wx:if="{{item.editionOrVersion}}"> · {{item.editionOrVersion}}</text></view><view class="plan-level" wx:if="{{currentPhase}}"><text>当前阶段</text><view>{{currentPhase.title}}</view><view class="level-days">D{{currentPhase.startDay}}—D{{currentPhase.endDay}}</view></view></view>

      <view class="section-bar"><view class="section-title">今天</view><text>核心 {{todayMainDone}}/1 · 可选 {{todaySideDone}}/2</text></view><button class="secondary-button" bindtap="goToday">返回今天</button>

      <view class="section-bar rhythm-heading"><view class="section-title">七日节奏</view></view>
      <view class="rhythm-card card" style="display:block;padding:12rpx 24rpx"><view class="rhythm-row {{item.current?'current':''}} {{item.complete?'complete':''}}" style="display:flex;align-items:center;gap:18rpx;padding:20rpx 4rpx;border-bottom:1rpx solid #e8f0f6" wx:for="{{rhythmDays}}" wx:key="goalDay"><view class="day-index" style="width:128rpx;margin:0">D{{item.goalDay}} · {{item.current?'今天':item.dayText}}</view><view class="rhythm-task" style="min-width:0;flex:1"><view>{{item.title}}</view><text wx:if="{{item.sourceTitle}}">{{item.sourceTitle}}</text></view><view>{{item.complete?'✓':'✦'}}</view></view></view>
    </block>
  </view>
  <view class="loading-pill" wx:if="{{loading}}"><view class="mini-spinner"></view>正在同步目标</view>
</view>

<view class="modal-mask" wx:if="{{editModal}}" bindtap="closeEdit"><view class="modal-card" catchtap="noop"><view class="modal-title">编辑今日任务</view><view class="field"><text class="field-label">任务标题</text><input class="field-control" data-key="editTitle" value="{{editTitle}}" bindinput="editInput"/></view><view class="field"><text class="field-label">任务说明</text><textarea class="field-control textarea" data-key="editDetail" value="{{editDetail}}" bindinput="editInput"/></view><view class="field"><text class="field-label">预计分钟</text><input class="field-control" type="number" data-key="editMinutes" value="{{editMinutes}}" bindinput="editInput"/></view><view class="safe-note">编辑只影响今天这项任务，仍对应原来的星星。</view><view class="modal-actions"><button class="secondary-button small-button" bindtap="closeEdit">取消</button><button class="primary-button small-button" bindtap="saveEdit">保存</button></view></view></view>
<view class="modal-mask" wx:if="{{previewModal}}" bindtap="closePreview"><view class="modal-card" catchtap="noop"><view class="modal-title">轻量模式预览</view><view class="modal-body">以下未完成任务将缩短到 15 分钟以内，标题、星星与完成记录均不改变。</view><view class="preview-item" wx:for="{{previewItems}}" wx:key="taskId"><view>{{item.title}}</view><text>{{item.before}} 分钟 → {{item.after}} 分钟</text></view><view class="modal-actions"><button class="secondary-button small-button" bindtap="closePreview">暂不调整</button><button class="primary-button small-button" bindtap="confirmLighten">确认调整</button></view></view></view>
<view class="modal-mask" wx:if="{{story}}"><view class="modal-card"><view class="modal-title">{{story.title}}</view><view class="modal-body">{{story.body}}</view><button class="primary-button small-button story-close" bindtap="closeStory">知道了</button></view></view>
