<view class="map-page watercolor-page"><view class="page-pad"><view class="map-header"><view class="tag">GOAL MAP</view><view class="page-title">目标工作台</view><view class="long-goal">{{plan.longTermGoal}}</view></view>
 <view class="stage-card card {{item.current?'current':''}}" wx:for="{{stages}}" wx:key="id"><view class="stage-top"><view><view class="stage-name">{{item.title}}</view><view class="stage-status">{{item.statusLabel}}</view></view><view class="stage-progress">{{item.progress}}%</view></view><view class="progress-track stage-track"><view class="progress-fill" style="width:{{item.progress}}%"></view></view><view class="stage-desc">{{item.description}}</view><view class="map-task {{task.done?'done':''}}" wx:for="{{item.tasks}}" wx:for-item="task" wx:key="id"><text>{{task.done?'✓':'·'}}</text><view><view>{{task.title}}</view><view class="task-minutes">{{task.estimatedMinutes}} 分钟</view></view></view></view>
 <view class="actions-card card"><view class="section-heading">调整计划</view><view class="action-grid"><button bindtap="openGoalEdit">编辑长期目标</button><button data-reason="TOO_HARD" bindtap="replanTap">细化当前阶段</button><button data-reason="INTERRUPTED" bindtap="replanTap">重新生成今日任务</button><button data-reason="NO_TIME" bindtap="replanTap">调整学习强度</button></view></view>
</view></view>
<view class="modal-mask" wx:if="{{goalModal}}"><view class="modal-card"><view class="modal-title">编辑长期目标</view><textarea class="field-control textarea goal-input" value="{{newGoal}}" bindinput="goalInput"/><view class="modal-actions"><button class="secondary-button small-button" bindtap="closeGoalEdit">取消</button><button class="primary-button small-button" bindtap="changeGoal">重新规划</button></view></view></view>
<view class="modal-mask" wx:if="{{story}}"><view class="modal-card"><view class="modal-title">{{story.title}}</view><view class="modal-body">{{story.body}}</view><button class="primary-button small-button close" bindtap="closeStory">知道了</button></view></view>
