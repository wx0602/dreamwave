.workbench-page{padding-bottom:50rpx}.workbench-header{display:flex;align-items:flex-start;justify-content:space-between;padding:18rpx 8rpx 20rpx}.workbench-header .page-title{margin-top:16rpx}.add-goal-button{flex:none;width:74rpx;height:74rpx;margin:8rpx 0 0 20rpx;padding:0;border-radius:24rpx;color:#fff;background:linear-gradient(135deg,#76bdff,#4f9ef0);box-shadow:0 12rpx 24rpx rgba(79,158,240,.25);font-size:42rpx;line-height:70rpx}.goal-switcher{width:calc(100vw - 72rpx);margin:4rpx 0 24rpx}.goal-list{display:flex;gap:16rpx;padding:4rpx 6rpx 14rpx}.goal-card{flex:none;width:300rpx;padding:24rpx;border:2rpx solid #e0edf7;border-radius:30rpx;background:rgba(255,255,255,.86);box-shadow:0 10rpx 28rpx rgba(70,120,160,.08)}.goal-card.selected{border-color:#73b9fa;background:#fff;box-shadow:0 14rpx 34rpx rgba(79,158,240,.18)}.goal-card-top{display:flex;justify-content:space-between;color:#7a91a5;font-size:20rpx}.goal-card-title{overflow:hidden;margin-top:12rpx;color:#344657;font-size:27rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.goal-card-meta{margin-top:8rpx;color:#8696a5;font-size:21rpx}.mini-track{overflow:hidden;height:8rpx;margin-top:16rpx;border-radius:10rpx;background:#e8f0f6}.mini-track view{height:100%;border-radius:10rpx;background:linear-gradient(90deg,#6db8ff,#78d6c7)}.empty-state{margin-top:24rpx;padding:56rpx 38rpx;text-align:center}.empty-star{color:#e6b953;font-size:68rpx;text-shadow:0 0 20rpx rgba(230,185,83,.35)}.empty-title{margin-top:10rpx;color:#344657;font-size:32rpx;font-weight:700}.empty-copy{margin:14rpx 0 28rpx;color:#7b8b99;line-height:1.6}.overview-card{padding:32rpx}.overview-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.eyebrow{color:#6ba9de;font-size:21rpx;font-weight:700;letter-spacing:2rpx}.overview-title{margin-top:8rpx;color:#344657;font-size:32rpx;font-weight:700;line-height:1.4}.map-link{flex:none;margin:0;padding:8rpx 0;color:#4f9ef0;background:transparent;font-size:23rpx;line-height:1.4}.metric-row{display:flex;margin-top:30rpx;padding:24rpx 0;border-top:1rpx solid #e8f0f6;border-bottom:1rpx solid #e8f0f6}.metric{flex:1;text-align:center}.metric+.metric{border-left:1rpx solid #e8f0f6}.metric text{color:#3f81ba;font-size:31rpx;font-weight:700}.metric view{margin-top:7rpx;color:#8a9aa8;font-size:20rpx}.current-map{display:flex;align-items:center;margin-top:24rpx;padding:20rpx;border-radius:24rpx;background:linear-gradient(135deg,#26395f,#18253f);box-shadow:inset 0 0 30rpx rgba(111,164,223,.13)}.map-mark{display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;color:#ffd876;font-size:39rpx;text-shadow:0 0 18rpx rgba(255,202,86,.8)}.map-copy{flex:1;margin-left:14rpx;color:#f7f1dc;font-size:24rpx;font-weight:600}.map-copy text{display:block;margin-top:5rpx;color:#9fb0cf;font-size:20rpx;font-weight:400}.map-percent{color:#ffd876;font-size:26rpx;font-weight:700}.section-bar{display:flex;align-items:flex-end;justify-content:space-between;margin:38rpx 6rpx 18rpx}.section-title{margin:0;color:#344657;font-size:31rpx;font-weight:700}.section-note{margin-top:7rpx;color:#8c9aa7;font-size:21rpx}.section-bar>text{color:#4f9ef0;font-size:27rpx;font-weight:700}.today-empty{padding:34rpx;color:#8495a4;text-align:center}.task-card{display:flex;align-items:center;gap:18rpx;margin-top:14rpx;padding:24rpx;border-left:7rpx solid #efbd58}.task-card.side{border-left-color:#75cdbc}.task-card.done{border-left-color:#b7c8d4;opacity:.72}.task-symbol{display:flex;flex:none;align-items:center;justify-content:center;width:56rpx;height:56rpx;border-radius:18rpx;color:#d89d2a;background:#fff6dc;font-size:28rpx;font-weight:700}.task-card.side .task-symbol{color:#3ca790;background:#e4f8f3}.task-card.done .task-symbol{color:#fff;background:#84c5a5}.task-body{min-width:0;flex:1}.task-top{display:flex;justify-content:space-between;gap:14rpx}.task-type{color:#b88025;font-size:20rpx;font-weight:700}.task-card.side .task-type{color:#369987}.task-time{color:#91a0ad;font-size:20rpx}.task-title{margin-top:8rpx;color:#3b4b5a;font-size:27rpx;font-weight:700;line-height:1.45}.task-detail{display:-webkit-box;overflow:hidden;margin-top:7rpx;color:#778896;font-size:22rpx;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:2}.task-more{flex:none;width:58rpx;height:58rpx;margin:0;padding:0;border-radius:18rpx;color:#718699;background:#edf4f9;font-size:24rpx;line-height:50rpx}.rhythm-heading{margin-top:42rpx}.rhythm-card{display:flex;justify-content:space-between;padding:24rpx 14rpx}.rhythm-day{min-width:0;flex:1;padding:14rpx 2rpx;border-radius:20rpx;text-align:center}.rhythm-day.current{background:#eaf5ff;box-shadow:inset 0 0 0 2rpx #a9d4ff}.rhythm-day.complete{background:#eefaf5}.rhythm-day.future{opacity:.48}.weekday{color:#627788;font-size:21rpx;font-weight:700}.rhythm-date{margin-top:5rpx;color:#95a2ae;font-size:18rpx}.day-dots{display:flex;justify-content:center;gap:2rpx;margin-top:13rpx;color:#dce3e9;font-size:16rpx}.day-dots .lit{color:#e8b74e;text-shadow:0 0 8rpx rgba(232,183,78,.45)}.day-index{margin-top:9rpx;color:#8999a7;font-size:18rpx}.adjust-card{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:24rpx;padding:28rpx}.adjust-copy{min-width:0;flex:1}.adjust-card button{flex:none;margin:0;padding:18rpx 22rpx;border-radius:20rpx;color:#4f86b6;background:#eaf5ff;font-size:22rpx;line-height:1.3}.safe-note{margin-top:20rpx;padding:16rpx 20rpx;border-radius:18rpx;color:#668394;background:#eff8fc;font-size:21rpx}.preview-item{margin-top:14rpx;padding:20rpx;border-radius:20rpx;background:#f4f8fb}.preview-item view{color:#435565;font-weight:600}.preview-item text{display:block;margin-top:7rpx;color:#4f9ef0;font-size:22rpx}.story-close{margin-top:28rpx}.loading-pill{position:fixed;z-index:900;left:50%;bottom:42rpx;display:flex;align-items:center;gap:12rpx;padding:16rpx 24rpx;border-radius:30rpx;color:#fff;background:rgba(35,55,77,.88);font-size:22rpx;transform:translateX(-50%)}.mini-spinner{width:24rpx;height:24rpx;border:3rpx solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin 1s linear infinite}.planning-card{margin-top:24rpx;padding:30rpx}.planning-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.quality-score{display:flex;align-items:baseline;gap:4rpx;color:#cf8d42;font-size:38rpx;font-weight:800}.quality-score text{font-size:19rpx}.quality-score.passed{color:#35a17f}.quality-status{margin-top:20rpx;padding:16rpx 18rpx;border-radius:18rpx;color:#57758a;background:#eef7fc;font-size:21rpx;line-height:1.55}.quality-status text{margin-right:8rpx;color:#35a17f;font-weight:700}.plan-level{display:grid;grid-template-columns:130rpx 1fr auto;gap:12rpx;margin-top:20rpx;padding-top:20rpx;border-top:1rpx solid #e7eef4;color:#405363;font-size:23rpx}.plan-level>text{color:#8093a2;font-size:20rpx}.level-days{color:#6499c5;font-size:20rpx}.plan-level.milestone{grid-template-columns:130rpx 1fr}.milestone-outcome{grid-column:2;margin-top:2rpx;color:#7d8e9b;font-size:20rpx;line-height:1.5}.role-row{display:flex;gap:8rpx;margin-top:22rpx}.role-row view{flex:1;padding:13rpx 4rpx;border-radius:16rpx;color:#58768b;background:#f4f8fb;text-align:center;font-size:19rpx}.role-row text{margin-right:3rpx;color:#d5a540}@media(max-width:340px){.metric text{font-size:27rpx}.adjust-card{align-items:stretch;flex-direction:column}.adjust-card button{width:100%}}
.priority-link{margin:14rpx 0 0;padding:0;color:#4f9ef0;background:transparent;text-align:left;font-size:21rpx;line-height:1.4}
