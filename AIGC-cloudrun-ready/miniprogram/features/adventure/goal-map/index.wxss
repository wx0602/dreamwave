.map-header{padding:18rpx 8rpx 28rpx}.map-header .page-title{margin-top:18rpx}.long-goal{margin-top:16rpx;color:#607180;line-height:1.7}.stage-card{position:relative;margin-top:22rpx;padding:32rpx;overflow:hidden}.stage-card.current{border-color:#7fc0ff;box-shadow:0 18rpx 50rpx rgba(79,158,240,.18)}.stage-card.current::before{content:"当前阶段";position:absolute;top:0;right:0;padding:10rpx 20rpx;border-radius:0 38rpx 0 22rpx;color:#fff;background:#6fb6ff;font-size:20rpx}.stage-top{display:flex;justify-content:space-between;align-items:flex-start}.stage-name{font-size:32rpx;font-weight:700}.stage-status{margin-top:8rpx;color:#718497;font-size:23rpx}.stage-progress{color:#4f9ef0;font-size:32rpx;font-weight:700}.stage-track{margin-top:22rpx}.stage-desc{margin-top:20rpx;color:#607180;line-height:1.65}.map-task{display:flex;gap:14rpx;margin-top:16rpx;padding:18rpx;border-radius:20rpx;background:#f4f9fd;color:#4f6070}.map-task.done{color:#69b98a}.task-minutes{margin-top:4rpx;color:#9aa6b2;font-size:21rpx}.actions-card{margin-top:24rpx;padding:32rpx}.section-heading{font-size:31rpx;font-weight:700}.action-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:22rpx}.action-grid button{padding:22rpx 12rpx;border-radius:22rpx;color:#4f7fab;background:#edf7ff;font-size:23rpx;line-height:1.3}.goal-input{margin-top:24rpx}.close{margin-top:26rpx}
