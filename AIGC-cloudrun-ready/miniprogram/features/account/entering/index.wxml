<view class="entering-page">
  <view class="entering-panel glass-card">
    <view class="emblem"><view class="emblem-core">✦</view></view>
    <view class="page-title">正在进入你的世界</view>
    <view class="page-subtitle">目标、角色与故事线正在彼此连接</view>
    <view class="stage">{{stage}}</view>
    <view class="progress-row"><view class="progress-track"><view class="progress-fill" style="width: {{progress}}%"></view></view><text>{{progress}}%</text></view>
    <view class="error" wx:if="{{error}}">{{error}}</view>
    <view class="error-actions" wx:if="{{error}}"><button class="primary-button small-button" bindtap="start">重新尝试</button><button class="secondary-button small-button" bindtap="back">返回修改</button></view>
  </view>
</view>
